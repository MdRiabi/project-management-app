{# templates/components/_topbar_admin.html.twig #}

{# Header/Topbar - Version améliorée avec Twig pur #}
<header class="h-16 bg-white dark:bg-gray-800 shadow-md z-40 sticky top-0 border-b border-gray-200 dark:border-gray-700">
    <div class="flex items-center justify-between h-full px-6">
        
        {# Partie Gauche : Recherche et Navigation Mobile #}
        <div class="flex items-center space-x-4 flex-1">
            
            {# Bouton Menu Mobile (seulement sur petits écrans) #}
            <button id="mobileMenuToggle" class="lg:hidden p-2 text-gray-500 dark:text-gray-400 hover:text-blue-500 transition">
                <i class="fas fa-bars text-xl"></i>
            </button>

            {# Barre de Recherche Avancée #}
            <div class="hidden md:block flex-1 max-w-xl">
                <div class="relative">
                    <input
                        type="search"
                        placeholder="Rechercher des utilisateurs, projets, rapports..."
                        class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                    >
                    <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400 dark:text-gray-500"></i>
                    <div class="absolute right-3 top-1/2 transform -translate-y-1/2">
                        <kbd class="px-1.5 py-0.5 text-xs border border-gray-300 dark:border-gray-600 rounded bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400">⌘K</kbd>
                    </div>
                </div>
            </div>
        </div>

        {# Partie Droite : Actions Utilisateur #}
        <div class="flex items-center space-x-3">
            
            {# Bouton Recherche Mobile #}
            <button id="mobileSearchToggle" class="md:hidden p-2 text-gray-500 dark:text-gray-400 hover:text-blue-500 transition">
                <i class="fas fa-search text-lg"></i>
            </button>

            {# Sélecteur de Thème #}
            <div class="relative theme-selector">
                <button 
                    id="themeToggle"
                    class="p-2 text-gray-500 dark:text-gray-400 hover:text-blue-500 transition relative"
                    title="Changer le thème"
                >
                    <i class="fas fa-moon text-lg theme-icon"></i>
                </button>
                
                {# Menu déroulant Thème #}
                <div 
                    id="themeMenu"
                    class="absolute right-0 mt-2 w-48 bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-gray-200 dark:border-gray-700 py-1 z-50 hidden"
                >
                    <button 
                        data-theme="light" 
                        class="theme-option w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 flex items-center space-x-2"
                    >
                        <i class="fas fa-sun text-yellow-500"></i>
                        <span>Thème Clair</span>
                    </button>
                    <button 
                        data-theme="dark" 
                        class="theme-option w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 flex items-center space-x-2"
                    >
                        <i class="fas fa-moon text-blue-500"></i>
                        <span>Thème Sombre</span>
                    </button>
                    <button 
                        data-theme="auto" 
                        class="theme-option w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 flex items-center space-x-2"
                    >
                        <i class="fas fa-desktop text-gray-500"></i>
                        <span>Auto (Système)</span>
                    </button>
                </div>
            </div>

            {# Notifications #}
            <div class="relative notifications-menu">
                <button 
                    id="notificationsToggle"
                    class="p-2 text-gray-500 dark:text-gray-400 hover:text-blue-500 transition relative"
                    title="Notifications"
                >
                    <i class="fas fa-bell text-lg"></i>
                    <span class="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center animate-pulse">
                        3
                    </span>
                </button>
                
                {# Menu déroulant Notifications #}
                <div 
                    id="notificationsMenu"
                    class="absolute right-0 mt-2 w-80 bg-white dark:bg-gray-800 rounded-lg shadow-xl border border-gray-200 dark:border-gray-700 z-50 hidden"
                >
                    <div class="p-4 border-b border-gray-200 dark:border-gray-700">
                        <h3 class="font-semibold text-gray-800 dark:text-white">Notifications</h3>
                        <span class="text-xs text-gray-500">3 non lues</span>
                    </div>
                    <div class="max-h-96 overflow-y-auto">
                        {# Liste des notifications #}
                        <div class="p-3 border-b border-gray-100 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer">
                            <div class="flex space-x-3">
                                <div class="flex-shrink-0">
                                    <div class="h-8 w-8 bg-blue-100 dark:bg-blue-900 rounded-full flex items-center justify-center">
                                        <i class="fas fa-user-plus text-blue-600 dark:text-blue-400 text-xs"></i>
                                    </div>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-gray-900 dark:text-white">
                                        Nouvel utilisateur inscrit
                                    </p>
                                    <p class="text-sm text-gray-500 dark:text-gray-400 truncate">
                                        John Doe a créé un compte
                                    </p>
                                    <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">Il y a 5 min</p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="p-3 border-b border-gray-100 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer">
                            <div class="flex space-x-3">
                                <div class="flex-shrink-0">
                                    <div class="h-8 w-8 bg-green-100 dark:bg-green-900 rounded-full flex items-center justify-center">
                                        <i class="fas fa-tasks text-green-600 dark:text-green-400 text-xs"></i>
                                    </div>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-gray-900 dark:text-white">
                                        Projet terminé
                                    </p>
                                    <p class="text-sm text-gray-500 dark:text-gray-400 truncate">
                                        Le projet "Refonte API" est finalisé
                                    </p>
                                    <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">Il y a 1h</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="p-2 border-t border-gray-200 dark:border-gray-700">
                        <a href="{{ path('admin_notifications') }}" class="block text-center text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 py-2">
                            Voir toutes les notifications
                        </a>
                    </div>
                </div>
            </div>

            {# Menu Profil Utilisateur #}
            <div class="relative profile-menu">
                <button 
                    id="profileToggle"
                    class="flex items-center space-x-3 p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition duration-200"
                >
                    <div class="relative">
                        <img 
                            src="{{ app.user.profilePicture ? asset('uploads/profile_pictures/' ~ app.user.profilePicture) : asset('assets/images/default-avatar.png') }}" 
                            alt="{{ app.user.firstName }} {{ app.user.lastName }}" 
                            class="h-8 w-8 rounded-full border-2 border-white dark:border-gray-700 object-cover"
                        >
                        <div class="absolute -bottom-1 -right-1 h-3 w-3 bg-green-500 border-2 border-white dark:border-gray-800 rounded-full"></div>
                    </div>
                    <div class="hidden lg:block text-left">
                        <span class="text-sm font-medium text-gray-800 dark:text-white block">
                            {{ app.user.firstName }} {{ app.user.lastName }}
                        </span>
                        <span class="text-xs text-gray-500 dark:text-gray-400 capitalize">
                            {% set mainRole = app.user.roles[0]|replace({'ROLE_': '', '_': ' '}) %}
                            {{ mainRole|lower }}
                        </span>
                    </div>
                    <i class="fas fa-chevron-down text-gray-400 text-xs hidden lg:block"></i>
                </button>
                
                {# Menu déroulant Profil #}
                <div 
                    id="profileMenu"
                    class="absolute right-0 mt-2 w-56 bg-white dark:bg-gray-800 rounded-lg shadow-xl border border-gray-200 dark:border-gray-700 py-1 z-50 hidden"
                >
                    <div class="px-4 py-3 border-b border-gray-200 dark:border-gray-700">
                        <p class="text-sm font-medium text-gray-900 dark:text-white">
                            {{ app.user.firstName }} {{ app.user.lastName }}
                        </p>
                        <p class="text-sm text-gray-500 dark:text-gray-400 truncate">
                            {{ app.user.email }}
                        </p>
                    </div>
                    
                    <a href="{{ path('user_profile') }}" class="flex items-center space-x-2 px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                        <i class="fas fa-user w-5"></i>
                        <span>Mon Profil</span>
                    </a>
                    
                    <a href="{{ path('user_settings') }}" class="flex items-center space-x-2 px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                        <i class="fas fa-cog w-5"></i>
                        <span>Paramètres</span>
                    </a>
                    
                    <div class="border-t border-gray-200 dark:border-gray-700 my-1"></div>
                    
                    <a href="{{ path('app_logout') }}" class="flex items-center space-x-2 px-4 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-gray-100 dark:hover:bg-gray-700">
                        <i class="fas fa-sign-out-alt w-5"></i>
                        <span>Déconnexion</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    {# Barre de recherche mobile (cachée par défaut) #}
    <div id="mobileSearch" class="md:hidden px-4 pb-4 bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 hidden">
        <div class="relative">
            <input
                type="search"
                placeholder="Rechercher..."
                class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
            <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
        </div>
    </div>
</header>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Gestion des menus déroulants
    function initDropdown(toggleId, menuId) {
        const toggle = document.getElementById(toggleId);
        const menu = document.getElementById(menuId);
        
        if (toggle && menu) {
            toggle.addEventListener('click', function(e) {
                e.stopPropagation();
                menu.classList.toggle('hidden');
                
                // Fermer les autres menus
                document.querySelectorAll('.profile-menu > div, .notifications-menu > div, .theme-selector > div')
                    .forEach(otherMenu => {
                        if (otherMenu !== menu && !otherMenu.classList.contains('hidden')) {
                            otherMenu.classList.add('hidden');
                        }
                    });
            });
        }
    }

    // Initialiser tous les menus
    initDropdown('profileToggle', 'profileMenu');
    initDropdown('notificationsToggle', 'notificationsMenu');
    initDropdown('themeToggle', 'themeMenu');

    // Fermer les menus en cliquant ailleurs
    document.addEventListener('click', function() {
        document.querySelectorAll('.profile-menu > div, .notifications-menu > div, .theme-selector > div')
            .forEach(menu => {
                menu.classList.add('hidden');
            });
    });

    // Empêcher la fermeture quand on clique dans le menu
    document.querySelectorAll('.profile-menu > div, .notifications-menu > div, .theme-selector > div')
        .forEach(menu => {
            menu.addEventListener('click', function(e) {
                e.stopPropagation();
            });
        });

    // Gestion du thème
    const themeButtons = document.querySelectorAll('.theme-option');
    const themeIcon = document.querySelector('.theme-icon');
    const currentTheme = localStorage.getItem('theme') || 'auto';
    
    // Appliquer le thème actuel
    applyTheme(currentTheme);
    
    themeButtons.forEach(button => {
        button.addEventListener('click', function() {
            const theme = this.getAttribute('data-theme');
            applyTheme(theme);
            localStorage.setItem('theme', theme);
            document.getElementById('themeMenu').classList.add('hidden');
        });
    });

    function applyTheme(theme) {
        const html = document.documentElement;
        
        if (theme === 'dark' || (theme === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            html.classList.add('dark');
            if (themeIcon) themeIcon.className = 'fas fa-sun text-lg theme-icon';
        } else {
            html.classList.remove('dark');
            if (themeIcon) themeIcon.className = 'fas fa-moon text-lg theme-icon';
        }
    }

    // Recherche mobile
    const mobileSearchToggle = document.getElementById('mobileSearchToggle');
    const mobileSearch = document.getElementById('mobileSearch');
    
    if (mobileSearchToggle && mobileSearch) {
        mobileSearchToggle.addEventListener('click', function() {
            mobileSearch.classList.toggle('hidden');
        });
    }

    // Menu mobile
    const mobileMenuToggle = document.getElementById('mobileMenuToggle');
    const sidebar = document.getElementById('admin-sidebar');
    
    if (mobileMenuToggle && sidebar) {
        mobileMenuToggle.addEventListener('click', function() {
            sidebar.classList.toggle('hidden');
        });
    }

    // Raccourci clavier pour la recherche (Cmd/Ctrl + K)
    document.addEventListener('keydown', function(e) {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
            e.preventDefault();
            const searchInput = document.querySelector('input[type="search"]');
            if (searchInput) searchInput.focus();
        }
    });

    // Observer les changements de préférence système pour le thème auto
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
        const currentTheme = localStorage.getItem('theme') || 'auto';
        if (currentTheme === 'auto') {
            applyTheme('auto');
        }
    });
});
</script>