<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Création de Compte | Admin{% endblock %}</title>

    {# Tailwind CSS #}
    <script src="https://cdn.tailwindcss.com"></script>

    {# Font Awesome Icons #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    {# Google Fonts #}
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        body { font-family: 'Inter', sans-serif; }
        
        /* Layout responds to a single state on body (expanded|mini) */
        @media (min-width: 1024px) {
            body[data-sidebar-state="expanded"] #layout-wrapper { padding-left: 16rem; }
            body[data-sidebar-state="mini"] #layout-wrapper { padding-left: 4rem; }
        }
    </style>
</head>
<body class="bg-gray-50" data-sidebar-state="expanded">
    {# Inclure le menu latéral de l'administrateur #}
    {% include 'components/_sidebar_admin.html.twig' %}

    {# Conteneur principal qui gère le décalage pour la sidebar #}
    <div id="layout-wrapper" class="flex flex-col transition-all duration-300">
        {# Inclure la barre supérieure (notifications, profil) #}
        {% include 'components/_topbar_admin.html.twig' %}

        {# Zone de Contenu Principal #}
        <main class="flex-1 p-6 dark:bg-gray-900 min-h-screen">

            {# En-tête de la Page (Titre et Retour) #}
            <div class="flex items-center mb-6">
                {# Bouton Retour vers la liste des utilisateurs #}
                <a href="{{ path('sysadmin_user_list') }}" class="text-gray-400 hover:text-white mr-4">
                    <i class="fas fa-arrow-left text-xl"></i>
                </a>
                <h1 class="text-3xl font-bold text-white">Add a New User</h1>
            </div>

            {# CONTENEUR DU FORMULAIRE #}
            <div class="max-w-8xl bg-gray-800 rounded-xl shadow-lg p-8">

                <h2 class="text-xl font-semibold text-white mb-6 border-b border-gray-700 pb-3">Creating a New User Account</h2>

                {# 1. Déclaration du Formulaire : UTILISATION DE LA MÉTHODE SYMFONY #}
                {{ form_start(creationForm, {'action': path('sysadmin_user_new'), 'attr': {'class': 'space-y-6'}}) }}

                    {# Affichage des Erreurs Générales du Formulaire (Non liées à un champ) #}
                    {{ form_errors(creationForm) }}

                    {# Styles réutilisables définis en variables #}
                    {% set field_classes = 'w-full mt-1 px-3 py-2 bg-gray-700 border border-gray-600 rounded-md text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent' %}
                    {% set container_classes = 'p-4 rounded-lg border border-gray-600 bg-gray-800/30 hover:bg-gray-700/40 transition duration-150' %}
                    {% set label_classes = 'block text-sm font-medium text-gray-300 mb-2' %}

                    <h3 class="text-lg font-bold text-gray-300 pt-4">Personal Information</h3>
                    <div class="space-y-6">
                        {# Prénom #}
                        <div class="{{ container_classes }}">
                            {{ form_row(creationForm.firstName, {
                                'row_attr': {'class': 'w-full'},
                                'label_attr': {'class': label_classes},
                                'attr': {'class': field_classes}
                            }) }}
                        </div>

                        {# Nom #}
                        <div class="{{ container_classes }}">
                            {{ form_row(creationForm.lastName, {
                                'row_attr': {'class': 'w-full'},
                                'label_attr': {'class': label_classes},
                                'attr': {'class': field_classes}
                            }) }}
                        </div>

                        {# Date de Naissance #}
                        <div class="{{ container_classes }}">
                            {{ form_row(creationForm.dateOfBirth, {
                                'row_attr': {'class': 'w-full'},
                                'label_attr': {'class': label_classes},
                                'attr': {'class': field_classes}
                            }) }}
                        </div>

                        {# Adresse #}
                        <div class="{{ container_classes }}">
                            {{ form_row(creationForm.address, {
                                'row_attr': {'class': 'w-full'},
                                'label_attr': {'class': label_classes},
                                'attr': {'class': field_classes}
                            }) }}
                        </div>

                        {# Email #}
                        <div class="{{ container_classes }}">
                            {{ form_row(creationForm.email, {
                                'row_attr': {'class': 'w-full'},
                                'label_attr': {'class': label_classes},
                                'attr': {'class': field_classes}
                            }) }}
                        </div>

                        {# Mot de Passe #}
                        <div class="{{ container_classes }}">
                            {{ form_row(creationForm.password, {
                                'row_attr': {'class': 'w-full'},
                                'label_attr': {'class': label_classes},
                                'attr': {'class': field_classes}
                            }) }}
                        </div>

                        {# Numéro d'Employé #}
                        <div class="{{ container_classes }}">
                            {{ form_row(creationForm.employeeId, {
                                'row_attr': {'class': 'w-full'},
                                'label_attr': {'class': label_classes},
                                'attr': {'class': field_classes}
                            }) }}
                        </div>
                    </div>

                    <h3 class="text-lg font-bold text-gray-300 pt-6 border-t border-gray-700">Professional Information</h3>
                    <div class="space-y-6">
                        {# Titre du Poste #}
                        <div class="{{ container_classes }}">
                            {{ form_row(creationForm.jobTitle, {
                                'row_attr': {'class': 'w-full'},
                                'label_attr': {'class': label_classes},
                                'attr': {'class': field_classes}
                            }) }}
                        </div>

                        {# Département #}
                        <div class="{{ container_classes }}">
                            {{ form_row(creationForm.department, {
                                'row_attr': {'class': 'w-full'},
                                'label_attr': {'class': label_classes},
                                'attr': {'class': field_classes}
                            }) }}
                        </div>

                        {# Équipe #}
                        <div class="{{ container_classes }}">
                            {{ form_row(creationForm.team, {
                                'row_attr': {'class': 'w-full'},
                                'label_attr': {'class': label_classes},
                                'attr': {'class': field_classes}
                            }) }}
                        </div>

                        {# Capacité Hebdomadaire #}
                        <div class="{{ container_classes }}">
                            {{ form_row(creationForm.capacityHours, {
                                'row_attr': {'class': 'w-full'},
                                'label_attr': {'class': label_classes},
                                'attr': {'class': field_classes}
                            }) }}
                        </div>

                        {# Rôles - Version verticale avec cases à cocher #}
                        <div class="space-y-6">
                            <label class="block text-sm font-medium text-gray-300 mb-4">Roles</label>
                            <div class="flex flex-col space-y-3">
                                {% for role in creationForm.roles %}
                                    <div class="flex items-center space-x-3 p-3 rounded-lg border border-gray-600 bg-gray-800/30 hover:bg-gray-700/40 transition duration-150 cursor-pointer">
                                        {{ form_widget(role, {
                                            'attr': {'class': 'h-4 w-4 text-blue-500 border-gray-500 bg-gray-700 rounded focus:ring-blue-500 focus:ring-2'}
                                        }) }}
                                        {{ form_label(role, null, {
                                            'label_attr': {'class': 'text-sm text-gray-200 cursor-pointer select-none'}
                                        }) }}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>

                        {# Compétences - Version verticale avec cases à cocher #}
                        <div class="space-y-6">
                            <label class="block text-sm font-medium text-gray-300 mb-4">SKILLS</label>
                            <div class="flex flex-col space-y-3">
                                {% for skill in creationForm.skills %}
                                    <div class="flex items-center space-x-3 p-3 rounded-lg border border-gray-600 bg-gray-800/30 hover:bg-gray-700/40 transition duration-150 cursor-pointer">
                                        {{ form_widget(skill, {
                                            'attr': {'class': 'h-4 w-4 text-blue-500 border-gray-500 bg-gray-700 rounded focus:ring-blue-500 focus:ring-2'}
                                        }) }}
                                        {{ form_label(skill, null, {
                                            'label_attr': {'class': 'text-sm text-gray-200 cursor-pointer select-none'}
                                        }) }}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>

                        {# Manager #}
                        <div class="{{ container_classes }}">
                            {{ form_row(creationForm.manager, {
                                'row_attr': {'class': 'w-full'},
                                'label_attr': {'class': label_classes},
                                'attr': {'class': field_classes}
                            }) }}
                        </div>

                        {# Checkbox Actif #}
                        <div class="flex items-center">
                            {{ form_widget(creationForm.isActive, {'attr': {'class': 'w-4 h-4 rounded border-gray-600 text-green-500 bg-gray-700 focus:ring-green-500 mr-2'}}) }}
                            <label for="{{ creationForm.isActive.vars.id }}" class="text-sm font-medium text-gray-300">Actif</label>
                        </div>
                    </div>

                    <h3 class="text-lg font-bold text-gray-300 pt-6 border-t border-gray-700">Files and Messages</h3>
                    <div class="space-y-6">
                        {# Photo de Profil #}
                        <div class="{{ container_classes }}">
                            {{ form_row(creationForm.profilePicture, {
                                'row_attr': {'class': 'w-full'},
                                'label_attr': {'class': label_classes},
                                'attr': {'class': field_classes}
                            }) }}
                        </div>

                        {# Message #}
                        <div class="{{ container_classes }}">
                            {{ form_row(creationForm.message, {
                                'row_attr': {'class': 'w-full'},
                                'label_attr': {'class': label_classes},
                                'attr': {'class': field_classes}
                            }) }}
                        </div>

                        {# Date de Création #}
                        <div class="{{ container_classes }}">
                            {{ form_row(creationForm.creationDate, {
                                'row_attr': {'class': 'w-full'},
                                'label_attr': {'class': label_classes},
                                'attr': {'class': field_classes}
                            }) }}
                        </div>
                    </div>

                    {# Rendu des champs restants (CSRF, etc.) et Fin du Formulaire #}
                    {{ form_rest(creationForm) }}

                    <div class="flex justify-end pt-6 border-t border-gray-700 mt-6">
                        <button type="submit" class="px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg shadow-lg hover:bg-blue-700 transition">
                            <i class="fas fa-user-plus mr-2"></i> Create User Account
                        </button>
                    </div>

                {{ form_end(creationForm) }}
            </div>
        </main>
    </div>

    <script>
        // Single source of truth: body[data-sidebar-state] controls both sidebar and layout
        (function () {
            function bindToggle() {
                const body = document.body;
                const btn = document.getElementById('sidebarToggle');
                const sidebar = document.getElementById('admin-sidebar');
                const title = document.getElementById('sidebar-title');
                if (!btn || !sidebar) return;

                // Ensure sidebar is never hidden/off-canvas
                sidebar.classList.remove('hidden', '-translate-x-full');
                sidebar.classList.add('lg:block');

                function syncFromBody() {
                    const state = body.getAttribute('data-sidebar-state') || 'expanded';
                    if (state === 'mini') {
                        sidebar.classList.add('sidebar-mini');
                        if (title) title.classList.add('hidden');
                    } else {
                        sidebar.classList.remove('sidebar-mini');
                        if (title) title.classList.remove('hidden');
                    }
                }

                if (!body.getAttribute('data-sidebar-state')) body.setAttribute('data-sidebar-state', 'expanded');
                syncFromBody();

                if (!btn.dataset.bound) {
                    btn.addEventListener('click', function (e) {
                        e.preventDefault();
                        const current = body.getAttribute('data-sidebar-state') === 'mini' ? 'expanded' : 'mini';
                        body.setAttribute('data-sidebar-state', current);
                        syncFromBody();
                    });
                    btn.dataset.bound = '1';
                }
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', bindToggle);
            } else {
                bindToggle();
            }
        })();
    </script>
</body>
</html>